#!/usr/bin/env bash
# dot — manage this dotfiles repo with GNU stow.
#
#   dot install     symlink everything under ./home into $HOME
#   dot uninstall   remove those symlinks
#   dot restow      re-link (use after adding or moving files)
#   dot help        show this help
#
# All tracked files live under ./home, mirroring your home directory:
#   home/.config/fish/config.fish  ->  ~/.config/fish/config.fish
#   home/.gitconfig                ->  ~/.gitconfig
#   home/.zshrc                    ->  ~/.zshrc
#
# Stow runs with --no-folding: it creates real directories and symlinks
# only the tracked files, so untracked local files (secrets, caches,
# machine state) always sit safely next to the symlinks.
set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}"
TARGET="$HOME"
PKG="home"

die() { echo "dot: $*" >&2; exit 1; }

ensure_stow() {
  command -v stow >/dev/null 2>&1 && return
  echo "==> stow not found; installing with Homebrew..."
  command -v brew >/dev/null 2>&1 || die "Homebrew not found. Install stow manually: https://www.gnu.org/software/stow/"
  brew install stow
}

run_stow() {
  stow --no-folding --dir="$DOTFILES_DIR" --target="$TARGET" --verbose "$@" "$PKG"
}

cmd="${1:-help}"

case "$cmd" in
  install)          ensure_stow; run_stow;    echo "==> installed." ;;
  uninstall|remove) ensure_stow; run_stow -D; echo "==> uninstalled." ;;
  restow|relink)    ensure_stow; run_stow -R; echo "==> restowed." ;;
  help|-h|--help)   awk 'NR>1 && /^#/{sub(/^# ?/,""); print; next} NR>1{exit}' "$0" ;;
  *)                die "unknown command '$cmd' (try: dot help)" ;;
esac
